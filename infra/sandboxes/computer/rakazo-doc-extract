#!/usr/bin/env python3
"""Unified Document & Thai OCR Extractor for PDF, DOCX, XLSX, PPTX, and Images."""

from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any


def ocr_image(image_path: Path, lang: str = "tha+eng") -> str:
    if not shutil.which("tesseract"):
        return ""
    proc = subprocess.run(
        ["tesseract", str(image_path), "stdout", "-l", lang],
        capture_output=True,
        text=True,
    )
    return proc.stdout.strip() if proc.returncode == 0 else ""


def extract_pdf(pdf_path: Path, lang: str = "tha+eng", min_chars_per_page: int = 20) -> dict[str, Any]:
    pages_output: list[dict[str, Any]] = []
    ocr_pages = 0
    try:
        from pypdf import PdfReader  # type: ignore

        reader = PdfReader(str(pdf_path))
        total_pages = len(reader.pages)
        for idx, page in enumerate(reader.pages, start=1):
            text = (page.extract_text() or "").strip()
            used_ocr = False
            if len(text) < min_chars_per_page and shutil.which("pdftoppm") and shutil.which("tesseract"):
                with tempfile.TemporaryDirectory(prefix="rakazo-pdf-ocr-") as tmp:
                    prefix = Path(tmp) / "page"
                    subprocess.run(
                        [
                            "pdftoppm",
                            "-png",
                            "-r",
                            "200",
                            "-f",
                            str(idx),
                            "-l",
                            str(idx),
                            str(pdf_path),
                            str(prefix),
                        ],
                        capture_output=True,
                        text=True,
                    )
                    rendered = sorted(Path(tmp).glob("page*.png"))
                    if rendered:
                        ocr_text = ocr_image(rendered[0], lang=lang)
                        if ocr_text:
                            text = ocr_text
                            used_ocr = True
                            ocr_pages += 1
            pages_output.append({"page": idx, "ocr": used_ocr, "text": text})
    except Exception as exc:
        if not shutil.which("pdftotext"):
            raise RuntimeError(f"Failed to parse PDF: {exc}") from exc
        proc = subprocess.run(["pdftotext", str(pdf_path), "-"], capture_output=True, text=True)
        if proc.returncode != 0:
            raise RuntimeError(
                (proc.stderr or "").strip() or f"Failed to parse PDF: {exc}"
            ) from exc
        raw_text = proc.stdout.strip()
        pages_output.append({"page": 1, "ocr": False, "text": raw_text})
        total_pages = 1

    combined = "\n\n".join(f"--- Page {p['page']} ---\n{p['text']}" for p in pages_output if p["text"])
    return {
        "path": str(pdf_path),
        "type": "pdf",
        "pageCount": total_pages,
        "ocrPages": ocr_pages,
        "text": combined,
        "pages": pages_output,
    }


def extract_docx(docx_path: Path) -> dict[str, Any]:
    try:
        import docx  # type: ignore

        doc = docx.Document(str(docx_path))
        blocks: list[str] = [p.text.strip() for p in doc.paragraphs if p.text and p.text.strip()]
        for table in doc.tables:
            for row in table.rows:
                cells = [c.text.strip().replace("\n", " ") for c in row.cells]
                blocks.append(" | ".join(cells))
        return {
            "path": str(docx_path),
            "type": "docx",
            "text": "\n".join(blocks),
        }
    except Exception as exc:
        if not shutil.which("pandoc"):
            raise RuntimeError(f"Failed to parse DOCX: {exc}") from exc
        proc = subprocess.run(["pandoc", str(docx_path), "-t", "markdown"], capture_output=True, text=True)
        if proc.returncode != 0:
            raise RuntimeError(
                (proc.stderr or "").strip() or f"Failed to parse DOCX: {exc}"
            ) from exc
        return {
            "path": str(docx_path),
            "type": "docx",
            "text": proc.stdout.strip(),
        }


def extract_xlsx(xlsx_path: Path, max_rows: int = 500) -> dict[str, Any]:
    import openpyxl  # type: ignore

    wb = openpyxl.load_workbook(str(xlsx_path), data_only=True, read_only=True)
    sheets_out: list[str] = []
    for name in wb.sheetnames:
        ws = wb[name]
        rows_str: list[str] = [f"### Sheet: {name}"]
        for idx, row in enumerate(ws.iter_rows(values_only=True), start=1):
            if idx > max_rows:
                rows_str.append(f"... (truncated after {max_rows} rows)")
                break
            vals = [str(cell) if cell is not None else "" for cell in row]
            if any(vals):
                rows_str.append(" | ".join(vals))
        sheets_out.append("\n".join(rows_str))
    return {
        "path": str(xlsx_path),
        "type": "xlsx",
        "sheets": wb.sheetnames,
        "text": "\n\n".join(sheets_out),
    }


def extract_pptx(pptx_path: Path) -> dict[str, Any]:
    from pptx import Presentation  # type: ignore

    prs = Presentation(str(pptx_path))
    slides_out: list[str] = []
    for idx, slide in enumerate(prs.slides, start=1):
        lines = [f"### Slide {idx}"]
        for shape in slide.shapes:
            if getattr(shape, "has_text_frame", False):
                txt = shape.text_frame.text.strip()
                if txt:
                    lines.append(txt)
        slides_out.append("\n".join(lines))
    return {
        "path": str(pptx_path),
        "type": "pptx",
        "slideCount": len(prs.slides),
        "text": "\n\n".join(slides_out),
    }


def extract_document(path: Path, lang: str = "tha+eng") -> dict[str, Any]:
    if not path.is_file():
        return {
            "ok": False,
            "path": str(path),
            "type": "missing",
            "error": f"File not found: {path}",
        }
    suffix = path.suffix.lower()
    try:
        if suffix == ".pdf":
            res = extract_pdf(path, lang=lang)
        elif suffix == ".docx":
            res = extract_docx(path)
        elif suffix in (".xlsx", ".xlsm"):
            res = extract_xlsx(path)
        elif suffix == ".pptx":
            res = extract_pptx(path)
        elif suffix in (".png", ".jpg", ".jpeg", ".webp", ".tif", ".tiff", ".bmp"):
            text = ocr_image(path, lang=lang)
            res = {"path": str(path), "type": "image_ocr", "text": text}
        else:
            res = {
                "path": str(path),
                "type": "text",
                "text": path.read_text(encoding="utf-8", errors="replace"),
            }
        res.setdefault("ok", True)
        return res
    except Exception as exc:
        return {
            "ok": False,
            "path": str(path),
            "type": suffix.lstrip(".") or "unknown",
            "error": str(exc),
        }


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="rakazo-doc-extract",
        description="Extract structured text and Thai+English OCR from PDF, DOCX, XLSX, PPTX, and image files.",
    )
    parser.add_argument("files", nargs="+", help="Document or image file paths to extract.")
    parser.add_argument("--lang", default="tha+eng", help="Tesseract OCR language pack (default: tha+eng).")
    parser.add_argument("--format", choices=["json", "markdown"], default="json", help="Output format.")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    results = [extract_document(Path(f), lang=args.lang) for f in args.files]
    overall_ok = len(results) > 0 and all(bool(item.get("ok")) for item in results)
    if args.format == "markdown":
        for item in results:
            if item.get("ok") is False:
                print(f"# {item['path']} (ERROR)\n\n{item.get('error', '')}\n")
            else:
                print(f"# {item['path']} ({item['type']})\n\n{item.get('text', '')}\n")
    else:
        print(json.dumps({"ok": overall_ok, "documents": results}, ensure_ascii=False, indent=2))
    return 0 if overall_ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
