def eval_json(client: CdpClient, session_id: str, expression: str) -> Any:
    result = client.call(
        "Runtime.evaluate",
        {
            "expression": expression,
            "contextId": client.context_id,
            "returnByValue": True,
            "awaitPromise": True,
        },
        session_id=session_id,
    )
    if result.get("exceptionDetails"):
        details = result["exceptionDetails"]
        text = (
            details.get("text")
            or (details.get("exception") or {}).get("description")
            or "evaluate failed"
        )
        raise RuntimeError(str(text))
    return (result.get("result") or {}).get("value")


def ensure_helpers(client: CdpClient, session_id: str) -> None:
    ensure_world(client, session_id)
    eval_json(client, session_id, EVAL_HELPERS)


def parse_retry_after_ms(headers: dict[str, Any] | None) -> int | None:
    if not isinstance(headers, dict):
        return None
    raw_val = None
    for k, v in headers.items():
        if isinstance(k, str) and k.lower() == "retry-after":
            raw_val = v
            break
    if raw_val is None:
        return None
    text = str(raw_val).strip()
    if not text:
        return None
    try:
        seconds = int(text)
        if seconds >= 0:
            return min(seconds * 1000, 300_000)
    except ValueError:
        pass
    return None


def find_document_response(
    client: Any,
    session_id: str,
    loader_id: str | None,
    frame_id: str | None,
) -> dict[str, Any] | None:
    store = getattr(client, "_document_responses", None)
    if not isinstance(store, dict):
        return None
    entries = store.get(str(session_id or "")) or store.get("") or []
    if not isinstance(entries, list):
        return None
    if loader_id:
        for entry in reversed(entries):
            if isinstance(entry, dict) and entry.get("loaderId") == loader_id:
                return entry
    if frame_id:
        for entry in reversed(entries):
            if isinstance(entry, dict) and entry.get("frameId") == frame_id:
                return entry
    return None


def find_document_failure(
    client: Any,
    session_id: str,
    loader_id: str | None,
    frame_id: str | None,
) -> dict[str, Any] | None:
    store = getattr(client, "_document_failures", None)
    if not isinstance(store, dict):
        return None
    entries = store.get(str(session_id or "")) or store.get("") or []
    if not isinstance(entries, list):
        return None
    if loader_id:
        for entry in reversed(entries):
            if isinstance(entry, dict) and entry.get("loaderId") == loader_id:
                return entry
    if frame_id:
        for entry in reversed(entries):
            if isinstance(entry, dict) and entry.get("frameId") == frame_id:
                return entry
    return None


def normalize_url_for_redirect(raw_url: str) -> str:
    try:
        sp = urlsplit(raw_url)
        path = sp.path or "/"
        return f"{sp.scheme.lower()}://{sp.netloc.lower()}{path}{('?' + sp.query) if sp.query else ''}"
    except Exception:
        return raw_url


def detect_challenge_page(
    title: str,
    body_snippet: str,
    has_challenge_dom: bool,
    http_status: int | None,
) -> str | None:
    if has_challenge_dom:
        return "bot_challenge"
    combined = f"{title}\n{body_snippet}".lower()
    cloudflare_markers = (
        "just a moment...",
        "attention required! | cloudflare",
        "checking your browser before accessing",
        "verify you are human",
        "cf-chl-bypass",
        "enable javascript and cookies to continue",
    )
    if any(marker in combined for marker in cloudflare_markers):
        return "cloudflare_challenge"
    captcha_markers = (
        "please complete the security check",
        "unusual traffic from your computer network",
        "กรุณายืนยันว่าคุณไม่ใช่บอท",
    )
    if any(marker in combined for marker in captcha_markers):
        return "captcha_challenge"
    if http_status in (403, 429, 503) and (
        "cloudflare" in combined or "captcha" in combined or "security check" in combined
    ):
        return "bot_challenge"
    return None


def navigate(client: CdpClient, session_id: str, url: str) -> dict[str, Any]:
    parsed = urlsplit(url)
    if parsed.scheme not in ("http", "https") or parsed.username or parsed.password:
        raise RuntimeError("Only HTTP(S) URLs without embedded credentials are supported")
    result = client.call("Page.navigate", {"url": url}, session_id=session_id, timeout_s=15.0)
    if result.get("errorText") or result.get("isDownload"):
        raise RuntimeError(result.get("errorText") or "Navigation started a download")
    deadline = time.monotonic() + 10.0
    while time.monotonic() < deadline:
        doc_failure = find_document_failure(
            client, session_id, result.get("loaderId"), result.get("frameId")
        )
        if doc_failure is not None:
            raise RuntimeError(str(doc_failure.get("errorText") or "Navigation failed"))
        try:
            frame = client.call("Page.getFrameTree", session_id=session_id)["frameTree"]["frame"]
            if result.get("loaderId") and frame.get("loaderId") != result["loaderId"]:
                time.sleep(0.1)
                continue
            ensure_world(client, session_id)
            ready = eval_json(client, session_id, "document.readyState")
            if ready in ("interactive", "complete"):
                page_info = eval_json(
                    client,
                    session_id,
                    """(() => {
                        let status = null;
                        let redirected = false;
                        try {
                            const nav = performance.getEntriesByType('navigation')[0];
                            if (nav) {
                                if (typeof nav.responseStatus === 'number' && Number.isInteger(nav.responseStatus) && nav.responseStatus > 0) {
                                    status = nav.responseStatus;
                                }
                                if (typeof nav.redirectCount === 'number' && nav.redirectCount > 0) {
                                    redirected = true;
                                }
                            }
                        } catch (e) {}
                        const bodyText = (document.body && document.body.innerText ? document.body.innerText : '').slice(0, 1000);
                        const hasChallengeDom = Boolean(
                            document.querySelector &&
                            document.querySelector(
                                '#challenge-running, #challenge-form, #cf-challenge-running, [name="cf-turnstile-response"], iframe[src*="challenges.cloudflare.com"], iframe[src*="recaptcha"], iframe[src*="hcaptcha"], .g-recaptcha, .h-captcha'
                            )
                        );
                        return {
                            url: location.href,
                            title: (document.title || '').slice(0, 200),
                            httpStatus: status,
                            redirected,
                            bodySnippet: bodyText,
                            hasChallengeDom
                        };
                    })()""",
                )
                if not isinstance(page_info, dict):
                    page_info = {
                        "url": eval_json(client, session_id, "location.href"),
                        "title": eval_json(client, session_id, "(document.title || '').slice(0, 200)"),
                        "httpStatus": None,
                    }
                loader_id = result.get("loaderId")
                frame_id = frame.get("id")
                doc_resp = find_document_response(client, session_id, loader_id, frame_id)
                cdp_status = doc_resp.get("status") if isinstance(doc_resp, dict) else None
                perf_status = page_info.get("httpStatus")
                if isinstance(cdp_status, int) and not isinstance(cdp_status, bool) and cdp_status > 0:
                    status_code: int | None = cdp_status
                elif isinstance(perf_status, int) and not isinstance(perf_status, bool) and perf_status > 0:
                    status_code = perf_status
                else:
                    status_code = None

                http_status_status = "known" if status_code is not None else "unknown"
                page_url = str(page_info.get("url") or (doc_resp or {}).get("url") or "")
                page_title = str(page_info.get("title") or "")
                redirect_chain = (
                    list(doc_resp.get("redirectChain") or [])
                    if isinstance(doc_resp, dict) and isinstance(doc_resp.get("redirectChain"), list)
                    else []
                )
                redirected = (
                    bool(redirect_chain)
                    or bool(page_info.get("redirected"))
                    or (
                        bool(page_url)
                        and normalize_url_for_redirect(page_url) != normalize_url_for_redirect(url)
                    )
                )
                retry_after_ms = (
                    parse_retry_after_ms(doc_resp.get("headers"))
                    if isinstance(doc_resp, dict)
                    else None
                )
                challenge_type = detect_challenge_page(
                    page_title,
                    str(page_info.get("bodySnippet") or ""),
                    bool(page_info.get("hasChallengeDom")),
                    status_code,
                )
                extra_fields: dict[str, Any] = {
                    "httpStatusStatus": http_status_status,
                }
                if status_code is not None:
                    extra_fields["httpStatus"] = status_code
                if redirected:
                    extra_fields["redirected"] = True
                if redirect_chain:
                    extra_fields["redirectChain"] = redirect_chain
                if retry_after_ms is not None:
                    extra_fields["retryAfterMs"] = retry_after_ms
                if challenge_type is not None:
                    extra_fields["challengeDetected"] = True
                    extra_fields["challengeType"] = challenge_type

                if status_code is not None and status_code >= 400:
                    return {
                        "ok": False,
                        **extra_fields,
                        "url": page_url,
                        "title": page_title,
                        "loaderId": loader_id,
                        "frameId": frame_id,
                        "error": f"HTTP {status_code} error: {page_title or 'Bad Response'}",
                        "fallback": "computer_act",
                    }
                if challenge_type is not None:
                    return {
                        "ok": False,
                        **extra_fields,
                        "url": page_url,
                        "title": page_title,
                        "loaderId": loader_id,
                        "frameId": frame_id,
                        "error": f"Anti-bot or security challenge detected ({challenge_type}): {page_title or page_url}",
                        "fallback": "computer_act",
                    }
                return {
                    "ok": True,
                    **extra_fields,
                    "url": page_url,
                    "title": page_title,
                    "loaderId": loader_id,
                    "frameId": frame_id,
                }
        except Exception:
            pass
        time.sleep(0.1)
    raise RuntimeError("Navigation did not settle; inspect the screen before continuing")


DEFAULT_CLEAR_STORAGE_TYPES = (
    "cookies",
    "local_storage",
    "indexeddb",
    "cache_storage",
    "service_workers",
)
ALLOWED_CLEAR_STORAGE_TYPES = frozenset(DEFAULT_CLEAR_STORAGE_TYPES)


def normalize_http_origin(raw_origin: Any) -> tuple[str, str, str]:
    if not isinstance(raw_origin, str) or not raw_origin.strip():
        raise ValueError("origin must be a non-empty HTTP(S) origin")
    parsed = urlsplit(raw_origin.strip())
    scheme = parsed.scheme.lower()
    if scheme not in ("http", "https") or not parsed.hostname:
        raise ValueError("origin must use http or https and include a hostname")
    if parsed.username or parsed.password:
        raise ValueError("origin must not contain credentials")
    if parsed.path not in ("", "/") or parsed.query or parsed.fragment:
        raise ValueError("origin must not contain a path, query, or fragment")
    hostname = parsed.hostname.lower()
    port = parsed.port
    host_display = f"[{hostname}]" if ":" in hostname else hostname
    if port is not None and not ((scheme == "http" and port == 80) or (scheme == "https" and port == 443)):
        netloc = f"{host_display}:{port}"
    else:
        netloc = host_display
    return f"{scheme}://{netloc}", scheme, hostname


def clear_origin_storage(
    client: CdpClient,
    session_id: str,
    args: dict[str, Any],
) -> dict[str, Any]:
    if not isinstance(args, dict):
        raise ValueError("args must be an object")
    origin, _scheme, hostname = normalize_http_origin(args.get("origin"))
    raw_storage_key = args.get("storageKey")
    storage_key: str | None = None
    if raw_storage_key is not None:
        if not isinstance(raw_storage_key, str) or not raw_storage_key.strip():
            raise ValueError("storageKey must be a non-empty string when provided")
        candidate_key = raw_storage_key.strip()
        key_origin_part = candidate_key.split("^", 1)[0].rstrip("/")
        try:
            normalized_key_origin, _, _ = normalize_http_origin(key_origin_part)
        except ValueError as exc:
            raise ValueError("storageKey does not contain a valid HTTP(S) origin") from exc
        if normalized_key_origin != origin:
            raise ValueError(f"storageKey origin {normalized_key_origin} does not match target origin {origin}")
        storage_key = candidate_key

    raw_types = args.get("storageTypes")
    if raw_types is None:
        requested_types = list(DEFAULT_CLEAR_STORAGE_TYPES)
    else:
        if not isinstance(raw_types, list) or not raw_types:
            raise ValueError("storageTypes must be a non-empty array when provided")
        requested_types = []
        for item in raw_types:
            if not isinstance(item, str) or item not in ALLOWED_CLEAR_STORAGE_TYPES:
                raise ValueError(
                    f"Unsupported or unsafe storageType: {item!r}. Allowed: {sorted(ALLOWED_CLEAR_STORAGE_TYPES)}"
                )
            if item not in requested_types:
                requested_types.append(item)

    include_session_storage = bool(args.get("includeSessionStorage") is True)
    include_subdomain_shared = bool(args.get("includeSubdomainSharedCookies") is True)

    cdp_storage_types = [t for t in requested_types if t != "cookies"]
    if cdp_storage_types:
        joined_types = ",".join(cdp_storage_types)
        if storage_key:
            client.call(
                "Storage.clearDataForStorageKey",
                {"storageKey": storage_key, "storageTypes": joined_types},
                session_id=session_id,
            )
        else:
            client.call(
                "Storage.clearDataForOrigin",
                {"origin": origin, "storageTypes": joined_types},
                session_id=session_id,
            )

    deleted_cookies = 0
    if "cookies" in requested_types:
        cookies_res = client.call(
            "Network.getCookies",
            {"urls": [origin, f"{origin}/"]},
            session_id=session_id,
        )
        cookies = cookies_res.get("cookies") if isinstance(cookies_res, dict) else []
        if isinstance(cookies, list):
            for cookie in cookies:
                if not isinstance(cookie, dict):
                    continue
                cookie_name = cookie.get("name")
                raw_domain = str(cookie.get("domain") or "")
                if not isinstance(cookie_name, str) or not cookie_name or not raw_domain:
                    continue
                clean_domain = raw_domain.lstrip(".").lower()
                is_exact_host = clean_domain == hostname
                is_parent_shared = hostname.endswith("." + clean_domain)
                if is_exact_host or (include_subdomain_shared and is_parent_shared):
                    delete_params: dict[str, Any] = {
                        "name": cookie_name,
                        "domain": raw_domain,
                        "url": origin,
                    }
                    if isinstance(cookie.get("path"), str) and cookie["path"]:
                        delete_params["path"] = cookie["path"]
                    if cookie.get("partitionKey") is not None:
                        delete_params["partitionKey"] = cookie["partitionKey"]
                    client.call("Network.deleteCookies", delete_params, session_id=session_id)
                    deleted_cookies += 1

    if include_session_storage:
        frame = client.call("Page.getFrameTree", session_id=session_id).get("frameTree", {}).get("frame", {})
        frame_origin = None
        if isinstance(frame, dict):
            sec_origin = frame.get("securityOrigin")
            frame_url = frame.get("url")
            for candidate in (sec_origin, frame_url):
                if isinstance(candidate, str) and candidate.startswith(("http://", "https://")):
                    try:
                        sp = urlsplit(candidate)
                        if sp.hostname:
                            frame_origin, _, _ = normalize_http_origin(f"{sp.scheme}://{sp.netloc}")
                            break
                    except ValueError:
                        pass
        if frame_origin != origin:
            raise RuntimeError(
                f"Cannot clear sessionStorage for {origin} while active tab is at {frame_origin or 'another origin'}"
            )
        client.call("DOMStorage.enable", session_id=session_id)
        storage_id: dict[str, Any] = {
            "securityOrigin": origin,
            "isLocalStorage": False,
        }
        if storage_key:
            storage_id["storageKey"] = storage_key
        client.call("DOMStorage.clear", {"storageId": storage_id}, session_id=session_id)

    harvested = getattr(client, "_harvested_apis", None)
    if isinstance(harvested, list):
        client._harvested_apis = [
            item
            for item in harvested
            if not (
                isinstance(item, dict)
                and str(item.get("url") or "").lower().startswith(origin.lower())
            )
        ]
        if hasattr(client, "save_persisted_state"):
            client.save_persisted_state()

    return {
        "ok": True,
        "origin": origin,
        "clearedStorageTypes": requested_types,
        "clearedSessionStorage": include_session_storage,
        "includeSubdomainSharedCookies": include_subdomain_shared,
        "deletedCookies": deleted_cookies,
        **({"storageKey": storage_key} if storage_key else {}),
    }


def snapshot(client: CdpClient, session_id: str) -> dict[str, Any]:
    ensure_helpers(client, session_id)
    data = eval_json(client, session_id, "window.__rakazoPageBrowser.snapshot()")
    if not isinstance(data, dict):
        raise RuntimeError("snapshot returned non-object")
    return {"ok": True, **data}


def act(client: CdpClient, session_id: str, actions: list[dict[str, Any]]) -> dict[str, Any]:
    if not actions or len(actions) > 24:
        raise RuntimeError("Expected 1 to 24 actions")
    for step in actions:
        if not isinstance(step, dict) or step.get("kind") not in ("click", "fill", "type"):
            raise RuntimeError("Invalid browser action")
        if not isinstance(step.get("ref"), str) or not step["ref"]:
            raise RuntimeError("Element ref is required")
        if step["kind"] != "click" and not isinstance(step.get("text"), str):
            raise RuntimeError("Text is required")
        if step.get("origin") is not None and (
            step["kind"] != "fill" or not isinstance(step["origin"], str)
        ):
            raise RuntimeError("An origin applies only to fill")
    ensure_helpers(client, session_id)
    completed = 0
    uncertain = False
    try:
        for step in actions:
            kind, ref = step["kind"], step["ref"]
            # Preflight catches stale refs before a mutation is dispatched.
            if not eval_json(client, session_id, f"Boolean(window.__rakazoPageBrowser.resolve({json.dumps(ref)}))"):
                raise RuntimeError("Stale element ref. Take a fresh snapshot.")
            arguments = json.dumps(ref)
            if kind != "click":
                arguments += ", " + json.dumps(step["text"])
            if step.get("origin"):
                arguments += ", " + json.dumps(step["origin"])
            uncertain = True
            data = eval_json(client, session_id, f"window.__rakazoPageBrowser.{kind}({arguments})")
            if not isinstance(data, dict):
                raise RuntimeError("Action response unavailable")
            completed += 1
            uncertain = False
        snap = snapshot(client, session_id)
        downloads = collect_download_receipts(client)
        return {
            **snap,
            "completed": completed,
            **({"downloads": downloads} if downloads else {}),
        }
    except Exception as exc:
        return {"ok": False, "completed": completed, "uncertain": uncertain,
                "error": str(exc), "fallback": "computer_act"}


MAX_DOWNLOAD_HASH_BYTES = 50 * 1024 * 1024
HASH_CHUNK_BYTES = 65_536


def hash_file_bounded(file_path: str, max_bytes: int = MAX_DOWNLOAD_HASH_BYTES) -> tuple[int, str | None, str | None]:
    size = os.path.getsize(file_path)
    if size > max_bytes:
        return size, None, "exceeds_50mb_limit"
    digest = hashlib.sha256()
    total_read = 0
    with open(file_path, "rb") as fh:
        while True:
            chunk = fh.read(HASH_CHUNK_BYTES)
            if not chunk:
                break
            total_read += len(chunk)
            if total_read > max_bytes:
                return total_read, None, "exceeds_50mb_limit"
            digest.update(chunk)
    return total_read, digest.hexdigest(), None


def _is_within_directory(target_dir: str, candidate_path: str) -> bool:
    try:
        real_dir = os.path.realpath(target_dir)
        real_candidate = os.path.realpath(candidate_path)
        return (
            real_candidate != real_dir
            and os.path.commonpath([real_dir, real_candidate]) == real_dir
        )
    except (ValueError, OSError):
        return False


def resolve_download_path(
    target_dir: str,
    guid: str,
    reported_path: str,
    *,
    enforce_dir: bool = False,
) -> str | None:
    candidate = (reported_path or "").strip()
    if candidate:
        resolved = candidate if os.path.isabs(candidate) or not target_dir else os.path.join(target_dir, candidate)
        if os.path.isfile(resolved):
            if enforce_dir and target_dir and os.path.isdir(target_dir):
                if not _is_within_directory(target_dir, resolved):
                    return None
            return resolved
        return None
    clean_guid = (guid or "").strip()
    if (
        clean_guid
        and "/" not in clean_guid
        and "\\" not in clean_guid
        and clean_guid not in (".", "..")
        and target_dir
    ):
        guid_path = os.path.join(target_dir, clean_guid)
        if os.path.isfile(guid_path) and _is_within_directory(target_dir, guid_path):
            return guid_path
    return None


def collect_download_receipts(
    client: Any,
    download_dir: str | None = None,
    max_hash_bytes: int = MAX_DOWNLOAD_HASH_BYTES,
) -> list[dict[str, Any]]:
    explicit_dir = download_dir or os.environ.get("RAKAZO_DOWNLOAD_DIR")
    target_dir = explicit_dir or os.path.expanduser("~/Downloads")
    enforce_dir = bool(explicit_dir)
    receipts: list[dict[str, Any]] = []
    downloads = getattr(client, "_downloads", None)
    if isinstance(downloads, dict):
        for guid, info in downloads.items():
            if not isinstance(info, dict):
                continue
            suggested = str(info.get("suggestedFilename") or "")
            reported_path = str(info.get("filePath") or "")
            state = str(info.get("state") or "unknown")
            verified_path = (
                resolve_download_path(
                    target_dir,
                    str(guid),
                    reported_path,
                    enforce_dir=enforce_dir,
                )
                if state == "completed"
                else None
            )
            entry: dict[str, Any] = {
                "guid": guid,
                "url": str(info.get("url") or ""),
                "name": suggested or (os.path.basename(verified_path) if verified_path else "") or "download",
                "state": state,
                "pathStatus": "known" if verified_path else "unknown",
            }
            if isinstance(info.get("receivedBytes"), int):
                entry["receivedBytes"] = int(info["receivedBytes"])
            if isinstance(info.get("totalBytes"), int):
                entry["totalBytes"] = int(info["totalBytes"])
            if verified_path:
                entry["path"] = verified_path
                try:
                    size, sha256_hex, skip_reason = hash_file_bounded(verified_path, max_bytes=max_hash_bytes)
                    entry["size"] = size
                    if sha256_hex is not None:
                        entry["sha256"] = sha256_hex
                    if skip_reason is not None:
                        entry["hashSkippedReason"] = skip_reason
                except OSError:
                    entry.pop("path", None)
                    entry["pathStatus"] = "unknown"
            receipts.append(entry)
    return receipts


def click_selector(
    client: CdpClient,
    session_id: str,
    args: dict[str, Any],
) -> dict[str, Any]:
    selector = str(args.get("selector") or "").strip()
    if not selector:
        return {"ok": False, "clicked": False, "error": "selector is required"}
    ensure_helpers(client, session_id)
    try:
        res = eval_json(
            client,
            session_id,
            f"""(() => {{
                const sel = {json.dumps(selector)};
                let el = null;
                if (/^e[0-9a-f]+$/i.test(sel)) {{
                    if (window.__rakazoPageBrowser && typeof window.__rakazoPageBrowser.resolve === "function") {{
                        el = window.__rakazoPageBrowser.resolve(sel);
                    }}
                    if (!el || el.isConnected === false) {{
                        return {{ ok: false, clicked: false, error: `Stale element ref: ${{sel}}` }};
                    }}
                }} else {{
                    try {{
                        el = document.querySelector(sel);
                    }} catch (err) {{
                        return {{ ok: false, clicked: false, error: `Invalid selector: ${{sel}}` }};
                    }}
                    if (!el || el.isConnected === false) {{
                        return {{ ok: false, clicked: false, error: `No element matches selector: ${{sel}}` }};
                    }}
                }}
                const style = window.getComputedStyle ? window.getComputedStyle(el) : null;
                if (style && (style.display === "none" || style.visibility === "hidden" || style.opacity === "0")) {{
                    return {{ ok: false, clicked: false, error: `Element has no visible box: ${{sel}}` }};
                }}
                const rect = el.getBoundingClientRect();
                if (rect.width <= 0 || rect.height <= 0) {{
                    return {{ ok: false, clicked: false, error: `Element has no visible box: ${{sel}}` }};
                }}
                let cur = el;
                while (cur) {{
                    if (
                        (cur.hasAttribute && cur.hasAttribute("disabled")) ||
                        (cur.getAttribute && cur.getAttribute("aria-disabled") === "true") ||
                        (cur.matches && cur.matches(":disabled")) ||
                        cur.disabled === true
                    ) {{
                        return {{ ok: false, clicked: false, error: `Element is disabled: ${{sel}}` }};
                    }}
                    cur = cur.parentElement || (cur.getRootNode && cur.getRootNode().host);
                }}
                el.focus();
                el.click();
                return {{
                    ok: true,
                    clicked: true,
                    url: location.href,
                    title: (document.title || "").slice(0, 200),
                }};
            }})()""",
        )
        if isinstance(res, dict):
            return res
        return {"ok": False, "clicked": False, "error": "click_selector returned non-object"}
    except Exception as exc:
        return {"ok": False, "clicked": False, "error": str(exc)}


SENSITIVE_JSON_KEY_SUBSTRINGS = (
    "password",
    "passwd",
    "pwd",
    "secret",
    "token",
    "authorization",
    "cookie",
    "set-cookie",
    "api_key",
    "apikey",
    "client_secret",
    "private_key",
    "session_id",
    "sessionid",
    "otp",
    "totp",
)
MAX_HARVEST_ITEM_BYTES = 16 * 1024
MAX_HARVEST_TOTAL_BYTES = 64 * 1024


def redact_sensitive_json(value: Any, depth: int = 0) -> Any:
    if depth > 12:
        return "[TRUNCATED_DEPTH]"
    if isinstance(value, dict):
        sanitized: dict[str, Any] = {}
        for k, v in value.items():
            key_str = str(k)
            key_lower = key_str.lower()
            if any(marker in key_lower for marker in SENSITIVE_JSON_KEY_SUBSTRINGS):
                sanitized[key_str] = "[REDACTED]"
            else:
                sanitized[key_str] = redact_sensitive_json(v, depth + 1)
        return sanitized
    if isinstance(value, list):
        return [redact_sensitive_json(item, depth + 1) for item in value[:100]]
    if isinstance(value, str) and len(value) > 4000:
        return value[:4000] + "...[TRUNCATED]"
    return value


def materialize_api_entries(client: CdpClient, session_id: str) -> list[dict[str, Any]]:
    store = getattr(client, "_api_responses", None)
    harvested = getattr(client, "_harvested_apis", None)
    if not isinstance(harvested, list):
        harvested = []
        setattr(client, "_harvested_apis", harvested)
    if not isinstance(store, dict):
        return harvested

    pending_entries: list[dict[str, Any]] = []
    for key in (session_id, ""):
        bucket = store.get(key)
        if isinstance(bucket, list) and bucket:
            pending_entries.extend(bucket)
            store[key] = []

    for item in pending_entries:
        if not isinstance(item, dict):
            continue
        u = str(item.get("url") or "")
        req_id = str(item.get("requestId") or "")
        body_data: Any = item.get("data")
        if body_data is None and req_id:
            try:
                raw_body = client.call(
                    "Network.getResponseBody",
                    {"requestId": req_id},
                    session_id=session_id,
                    timeout_s=5.0,
                )
                body_str = str(raw_body.get("body") or "")
                if raw_body.get("base64Encoded"):
                    body_str = base64.b64decode(body_str).decode("utf-8", errors="replace")
                try:
                    body_data = json.loads(body_str)
                except Exception:
                    body_data = body_str[:4000]
            except Exception:
                body_data = None
        if body_data is not None:
            body_data = redact_sensitive_json(body_data)
            try:
                encoded = json.dumps(body_data, ensure_ascii=False)
                if len(encoded.encode("utf-8")) > MAX_HARVEST_ITEM_BYTES:
                    body_data = {
                        "truncated": True,
                        "preview": encoded[:4000],
                    }
            except Exception:
                body_data = str(body_data)[:4000]
        record: dict[str, Any] = {
            "url": u,
            "status": item.get("status"),
            "mimeType": item.get("mimeType"),
            **({"data": body_data} if body_data is not None else {}),
        }
        harvested.append(record)
    if len(harvested) > 50:
        del harvested[:-50]
    if hasattr(client, "save_persisted_state"):
        client.save_persisted_state()
    return harvested


def harvest_json_apis(
    client: CdpClient,
    session_id: str,
    args: dict[str, Any],
) -> dict[str, Any]:
    url_filter = str(args.get("urlFilter") or "").strip().lower()
    max_items = min(max(int(args.get("maxItems") or 10), 1), 50)
    entries = materialize_api_entries(client, session_id)
    matched: list[dict[str, Any]] = []
    total_bytes = 0
    for item in reversed(entries):
        if not isinstance(item, dict):
            continue
        u = str(item.get("url") or "")
        if url_filter and url_filter not in u.lower():
            continue
        sanitized_item: dict[str, Any] = {
            "url": u,
            "status": item.get("status"),
            "mimeType": item.get("mimeType"),
        }
        if "data" in item and item["data"] is not None:
            sanitized_item["data"] = redact_sensitive_json(item["data"])
        item_bytes = len(json.dumps(sanitized_item, ensure_ascii=False).encode("utf-8"))
        if matched and total_bytes + item_bytes > MAX_HARVEST_TOTAL_BYTES:
            break
        total_bytes += item_bytes
        matched.append(sanitized_item)
        if len(matched) >= max_items:
            break
    return {"ok": True, "apis": matched}


def bezier_pointer_points(
    x0: float,
    y0: float,
    x1: float,
    y1: float,
    steps: int = 12,
) -> list[tuple[int, int]]:
    steps = max(2, min(steps, 40))
    dx = x1 - x0
    dy = y1 - y0
    cx1 = x0 + dx * 0.28 - dy * 0.12
    cy1 = y0 + dy * 0.18 + dx * 0.08
    cx2 = x0 + dx * 0.72 + dy * 0.09
    cy2 = y0 + dy * 0.84 - dx * 0.06
    points: list[tuple[int, int]] = []
    for i in range(1, steps + 1):
        t = i / steps
        inv = 1.0 - t
        bx = (
            (inv**3) * x0
            + 3 * (inv**2) * t * cx1
            + 3 * inv * (t**2) * cx2
            + (t**3) * x1
        )
        by = (
            (inv**3) * y0
            + 3 * (inv**2) * t * cy1
            + 3 * inv * (t**2) * cy2
            + (t**3) * y1
        )
        points.append((int(round(bx)), int(round(by))))
    return points


STEALTH_INIT_SCRIPT = r"""
(() => {
  try {
    Object.defineProperty(navigator, 'webdriver', { get: () => false });
    if (!window.chrome) {
      window.chrome = { runtime: {} };
    }
    Object.defineProperty(navigator, 'languages', { get: () => ['en-US', 'en', 'th-TH', 'th'] });
  } catch {}
})();
"""


def apply_stealth_evasion(client: CdpClient, session_id: str) -> dict[str, Any]:
    client.call(
        "Page.addScriptToEvaluateOnNewDocument",
        {"source": STEALTH_INIT_SCRIPT},
        session_id=session_id,
    )
    try:
        client.call(
            "Runtime.evaluate",
            {"expression": STEALTH_INIT_SCRIPT, "returnByValue": True},
            session_id=session_id,
        )
    except Exception:
        pass
    return {"ok": True, "stealth": True}


def observe_challenge_state(client: CdpClient, session_id: str) -> dict[str, Any] | None:
    try:
        ensure_world(client, session_id)
        info = eval_json(
            client,
            session_id,
            r"""(() => {
              const tokenInputs = Array.from(
                document.querySelectorAll(
                  '[name="cf-turnstile-response"], [name="g-recaptcha-response"], [name="h-captcha-response"]'
                )
              );
              const tokens = tokenInputs
                .map((el) => (typeof el.value === "string" ? el.value.trim() : ""))
                .filter((v) => v.length > 0);
              const hasToken = tokens.length > 0;
              const tokenValue = tokens.join("|");
              const hasChallengeDom = Boolean(
                document.querySelector(
                  '#challenge-running, #challenge-form, #cf-challenge-running, iframe[src*="challenges.cloudflare.com"], iframe[src*="turnstile"], iframe[src*="recaptcha"], iframe[src*="hcaptcha"], .cf-turnstile, .g-recaptcha, .h-captcha'
                )
              );
              let httpStatus = null;
              try {
                const nav = performance.getEntriesByType("navigation")[0];
                if (nav && typeof nav.responseStatus === "number" && nav.responseStatus > 0) {
                  httpStatus = nav.responseStatus;
                }
              } catch (e) {}
              const title = (document.title || "").slice(0, 200);
              const bodySnippet = (document.body && document.body.innerText ? document.body.innerText : "").slice(0, 1000);
              return { hasToken, tokenValue, hasChallengeDom, httpStatus, title, bodySnippet, url: location.href };
            })()""",
        )
        return info if isinstance(info, dict) else None
    except Exception:
        return None


def _is_error_page_observation(
    client: CdpClient,
    session_id: str,
    obs: dict[str, Any],
) -> bool:
    url = str(obs.get("url") or "").strip()
    if not url.startswith(("http://", "https://")):
        return True
    obs_status = obs.get("httpStatus")
    if isinstance(obs_status, int) and not isinstance(obs_status, bool) and obs_status >= 400:
        return True
    doc_resp = find_document_response(client, session_id, None, None)
    if isinstance(doc_resp, dict):
        cdp_status = doc_resp.get("status")
        if isinstance(cdp_status, int) and not isinstance(cdp_status, bool) and cdp_status >= 400:
            return True
    if find_document_failure(client, session_id, None, None) is not None:
        return True
    combined = f"{obs.get('title') or ''}\n{obs.get('bodySnippet') or ''}".lower()
    error_markers = (
        "502 bad gateway",
        "503 service temporarily unavailable",
        "504 gateway time-out",
        "500 internal server error",
        "403 forbidden",
        "404 not found",
        "this site can’t be reached",
        "this site can't be reached",
        "err_connection_",
        "err_name_not_resolved",
    )
    return any(marker in combined for marker in error_markers)


def solve_challenge(
    client: CdpClient,
    session_id: str,
    args: dict[str, Any],
) -> dict[str, Any]:
    target_x = args.get("x")
    target_y = args.get("y")
    if not (isinstance(target_x, (int, float)) and isinstance(target_y, (int, float))):
        ensure_helpers(client, session_id)
        box = eval_json(
            client,
            session_id,
            r"""(() => {
              const sel = 'iframe[src*="challenges.cloudflare.com"], iframe[src*="turnstile"], iframe[src*="hcaptcha"], iframe[src*="recaptcha"], .cf-turnstile, #challenge-stage input[type="checkbox"]';
              const el = document.querySelector(sel);
              if (!el) return null;
              const r = el.getBoundingClientRect();
              if (r.width <= 0 || r.height <= 0) return null;
              return { x: Math.round(r.left + Math.min(32, r.width / 2)), y: Math.round(r.top + r.height / 2) };
            })()""",
        )
        if not isinstance(box, dict):
            return {
                "ok": False,
                "dispatched": False,
                "status": "no_widget",
                "solved": False,
                "businessGoalVerified": False,
                "requiresTakeover": True,
                "fallback": "request_takeover",
                "error": "No challenge widget located on page",
            }
        target_x = int(box["x"])
        target_y = int(box["y"])
    pre = observe_challenge_state(client, session_id)
    start_x = int(args.get("startX") or max(10, int(target_x) - 140))
    start_y = int(args.get("startY") or max(10, int(target_y) - 90))
    trajectory = bezier_pointer_points(start_x, start_y, float(target_x), float(target_y), steps=12)
    for px, py in trajectory:
        client.call(
            "Input.dispatchMouseEvent",
            {"type": "mouseMoved", "x": px, "y": py, "button": "none"},
            session_id=session_id,
        )
    fx, fy = trajectory[-1]
    client.call(
        "Input.dispatchMouseEvent",
        {"type": "mousePressed", "x": fx, "y": fy, "button": "left", "clickCount": 1},
        session_id=session_id,
    )
    client.call(
        "Input.dispatchMouseEvent",
        {"type": "mouseReleased", "x": fx, "y": fy, "button": "left", "clickCount": 1},
        session_id=session_id,
    )
    settle_ms = int(args.get("settleMs", 250))
    if settle_ms > 0:
        time.sleep(min(settle_ms, 5000) / 1000.0)
    post = observe_challenge_state(client, session_id)
    if isinstance(post, dict):
        if _is_error_page_observation(client, session_id, post):
            return {
                "ok": False,
                "dispatched": True,
                "status": "navigation_error",
                "solved": False,
                "businessGoalVerified": False,
                "requiresTakeover": True,
                "fallback": "request_takeover",
                "clickedAt": {"x": fx, "y": fy},
                "trajectoryPoints": len(trajectory),
                "error": "Page navigated to an error page during challenge verification; request user takeover.",
            }
        post_has_token = bool(post.get("hasToken"))
        post_token_val = str(post.get("tokenValue") or "")
        pre_has_token = bool(pre.get("hasToken")) if isinstance(pre, dict) else False
        pre_token_val = str(pre.get("tokenValue") or "") if isinstance(pre, dict) else ""
        # A pre-existing token that did not change after clicking is stale.
        stale_preexisting_token = pre_has_token and (
            not post_has_token or post_token_val == pre_token_val
        )
        fresh_token = post_has_token and not stale_preexisting_token
        post_has_dom = bool(post.get("hasChallengeDom"))
        post_text_challenge = detect_challenge_page(
            str(post.get("title") or ""),
            str(post.get("bodySnippet") or ""),
            False,
            post.get("httpStatus") if isinstance(post.get("httpStatus"), int) else None,
        )
        still_challenged = (
            stale_preexisting_token
            or post_has_dom
            or (not fresh_token and post_text_challenge is not None)
        )
        if not still_challenged and (fresh_token or not post_has_dom):
            return {
                "ok": True,
                "dispatched": True,
                "status": "verified",
                "solved": True,
                "businessGoalVerified": False,
                "clickedAt": {"x": fx, "y": fy},
                "trajectoryPoints": len(trajectory),
            }
        return {
            "ok": False,
            "dispatched": True,
            "status": "still_challenged",
            "solved": False,
            "businessGoalVerified": False,
            "requiresTakeover": True,
            "fallback": "request_takeover",
            "clickedAt": {"x": fx, "y": fy},
            "trajectoryPoints": len(trajectory),
            "error": "Challenge remains active after click; request user takeover.",
        }
    return {
        "ok": False,
        "dispatched": True,
        "status": "unknown",
        "solved": False,
        "businessGoalVerified": False,
        "requiresTakeover": True,
        "fallback": "request_takeover",
        "clickedAt": {"x": fx, "y": fy},
        "trajectoryPoints": len(trajectory),
        "error": "Challenge state could not be verified after click; request user takeover.",
    }


def flush_and_persist_state(client: CdpClient, session_id: str | None = None) -> None:
    if session_id:
        try:
            materialize_api_entries(client, session_id)
        except Exception:
            pass
    if hasattr(client, "save_persisted_state"):
        client.save_persisted_state()


def exit_when_stdin_closes() -> None:
    """The supervisor owns this pipe; losing it cancels this helper, not Chromium."""
    try:
        while os.read(0, 1024):
            pass
    finally:
        os._exit(130)


def read_stdin_line() -> str:
    """Read one line from fd 0 unbuffered, leaving the rest of stdin for the EOF watcher."""
    data = bytearray()
    while len(data) < 1_048_576:
        chunk = os.read(0, 1)
        if not chunk or chunk == b"\n":
            break
        data += chunk
    return data.decode("utf-8")


def run(argv: list[str]) -> int:
    stdin_args = (
        read_stdin_line() if os.environ.get("RAKAZO_BROWSER_ARGS_STDIN") == "1" else None
    )
    if os.environ.get("RAKAZO_BROWSER_WATCH_STDIN") == "1":
        threading.Thread(target=exit_when_stdin_closes, daemon=True).start()
    if len(argv) < 2:
        print(
            json.dumps(
                {
                    "ok": False,
                    "error": "usage: rakazo-page-browser <command> [json-args]",
                    "fallback": "computer_act",
                }
            )
        )
        return 2
    command = argv[1]
    args: dict[str, Any] = {}
    raw_args = stdin_args if stdin_args is not None else (argv[2] if len(argv) >= 3 else "")
    if raw_args.strip():
        args = json.loads(raw_args)
    port = cdp_port()
    try:
        wait_for_cdp(port)
        ws_url = discover_ws_url(port)
        client = CdpClient(ws_url, state_file=default_state_file(port))
        client.connect()
        session_id: str | None = None
        try:
            session_id = attach_page(client)
            if command == "navigate":
                result = navigate(client, session_id, str(args.get("url") or ""))
            elif command == "snapshot":
                result = snapshot(client, session_id)
            elif command == "act":
                actions = args.get("actions")
                if not isinstance(actions, list):
                    raise RuntimeError("actions must be an array")
                result = act(client, session_id, actions)
            elif command == "click_selector":
                result = click_selector(client, session_id, args)
            elif command == "downloads":
                result = {
                    "ok": True,
                    "downloads": collect_download_receipts(client, args.get("downloadDir")),
                }
            elif command == "clear_origin_storage":
                result = clear_origin_storage(client, session_id, args)
            elif command == "harvest_json":
                result = harvest_json_apis(client, session_id, args)
            elif command == "solve_challenge":
                result = solve_challenge(client, session_id, args)
            elif command == "stealth":
                result = apply_stealth_evasion(client, session_id)
            else:
                result = {
                    "ok": False,
                    "error": f"unknown command: {command}",
                    "fallback": "computer_act",
                }
                print(json.dumps(result))
                return 2
            flush_and_persist_state(client, session_id)
            print(json.dumps(result))
            return 0  # Structured failures preserve partial action progress.
        finally:
            flush_and_persist_state(client, session_id)
            client.close()
    except Exception as exc:  # noqa: BLE001
        print(json.dumps({"ok": False, "error": str(exc), "fallback": "computer_act",
                              "uncertain": command == "act"}))
        return 0


if __name__ == "__main__":
    sys.exit(run(sys.argv))
