      });
      const coverage = (hasFrames || hasClosedShadow) ? 0.75 : 1.0;
      let notes = "";
      if (hasFrames) notes += "\nEmbedded frames require desktop tools.";
      if (hasClosedShadow) notes += "\nClosed Shadow DOM components require desktop tools.";

      return {
        url: location.href,
        title: (document.title || "").slice(0, 200),
        elements,
        tree: (document.body?.innerText || "").slice(0, 12000) + "\n" + formatTree(elements, true) + notes,
        hasFrames,
        hasClosedShadow,
        coverage,
      };
    },

    observe() {
      const { rawElements, hasFrames, hasClosedShadow } = scanElements();
      const elements = rawElements.map(item => {
        const { node, ...rest } = item;
        return rest;
      });
      const coverage = (hasFrames || hasClosedShadow) ? 0.75 : 1.0;
      let notes = "";
      if (hasFrames) notes += "\nEmbedded frames require desktop tools.";
      if (hasClosedShadow) notes += "\nClosed Shadow DOM components require desktop tools.";

      return {
        url: location.href,
        title: (document.title || "").slice(0, 200),
        elements,
        tree: (document.body?.innerText || "").slice(0, 12000) + "\n" + formatTree(elements, false) + notes,
        hasFrames,
        hasClosedShadow,
        coverage,
      };
    },

    resolve(ref) {
      const el = refMap.get(String(ref));
      if (!el || !el.isConnected || !visible(el)) return null;
      if (isDisabled(el)) {
